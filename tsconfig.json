{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "index.ts",
    "file-read-preview.ts",
    "focus-decision-note.ts",
    "focus-preset.ts",
    "focus-route-override.ts",
    "focus-session-state.ts",
    "focus-skills.ts",
    "monofold-read-ops.ts",
    "path-normalize.ts",
    "read-caps.ts",
    "unknown-path-allows.ts",
    "validation.ts",
    "tests/**/*.ts"
  ]
}
